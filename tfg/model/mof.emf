@namespace(
	uri="mof", 
	prefix="mof")
package mof;

@gmf.diagram()
class UMLDiagram {
	val Nodo[*] nodos;
	val Enlace[*] enlaces;
}

enum Color {
	Blanco;
	Negro;
	Rojo;
	Verde;
	Amarillo;
	Azul;
	Rosa;
	Lila;
	Naranja;
}

@gmf.node(label="nombre")
class Nodo {
    attr String nombre;
    attr Color color = "Blanco";
    attr String descripcion;
}

@gmf.link(source="origen", target="destino", style="solid", target.decoration="arrow")
class Enlace {
    ref Nodo[1] origen;
    ref Nodo[1] destino;
}