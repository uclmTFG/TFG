@namespace(
	uri="mof", 
	prefix="mof")
package mof;

@gmf.diagram()
class UMLDiagram {
	val Nodo[*] nodos;
	val Enlace[*] enlaces;
}

enum Color {
	Blanco;
	Negro;
	Rojo;
	Verde;
	Amarillo;
	Azul;
	Rosa;
	Lila;
	Naranja;
}

enum Forma {
	Rectangulo;
	RectanguloRedondeado;
	Circulo;
	CirculoDoble;
	Barra;
	Rombo;
	Actor;
}

enum Linea {
	Continua;
	Discontinua;
}

enum Tipo {
	Atributo;
	Método;
}

enum Visibilidad {
	Privado;
	Publico;
	Protegido;
	Paquete;
	Estático;
}

enum FormaExtremoOrigen {
	Ninguna;
	FlechaAbierta;
	FlechaCerrada;
}

enum FormaExtremoDestino{
	Ninguna;
	RomboSinRelleno;
	RomboRelleno;
}

abstract class Nodo {
	attr String nombre;
	attr Color color = "Blanco";
}

@gmf.node(label="nombre", figure="rectangle")
class Package extends Nodo {
	@gmf.compartment
	val Nodo[*] nodos;
}

@gmf.node(label="nombre")
class NodoUno extends Nodo {
    attr Forma forma ="Rectangulo";
    attr Color colorBorde = "Blanco";
}

@gmf.node(label="nombre")
class NodoDos extends Nodo {
    @gmf.compartiment(layout="list", collapsible="true")
    val AtributosMetodos[*] atributometodo;
}

@gmf.node(label="nombre")
class AtributosMetodos extends Nodo {
    attr Tipo tipo ="Atributo";
    attr Visibilidad visibilidad ="Publico";
}


@gmf.link(source="origen", target="destino", style="solid", target.decoration="arrow")
class Enlace {
    ref Nodo[1] origen;
    ref Nodo[1] destino;
}

