@namespace(
	uri="mof", 
	prefix="mof")
package mof;

@gmf.diagram()
class UMLDiagram {
	val Nodo[*] nodos;
	val Enlace[*] enlaces;
}

enum Color {
	Blanco;
	Negro;
	Rojo;
	Verde;
	Amarillo;
	Azul;
	Rosa;
	Lila;
	Naranja;
}

enum Linea {
	Continua;
	Discontinua;
}

enum FormaExtremoOrigen {
	Ninguna;
	FlechaAbierta;
	FlechaCerrada;
}

enum FormaExtremoDestino{
	Ninguna;
	RomboSinRelleno;
	RomboRelleno;
}

abstract class Nodo {
	attr String nombre;
	attr Color color = "Blanco";
	attr Color colorBorde = "Blanco";
}

@gmf.node(label="nombre", figure="rectangle")
class NodoUno extends Nodo {
    @gmf.compartment(layout="list", collapsible="true")
    val NodoDos[*] nodosDos;
}

@gmf.node(label="nombre")
class NodoDos extends Nodo {
    attr String forma;
    attr Linea linea = "Continua";
}


@gmf.link(source="origen", target="destino", style="solid", 
target.decoration="arrow", label="texto")
class Enlace {
	attr String texto;
    ref Nodo[1] origen;
    ref Nodo[1] destino;
    attr Linea linea = "Continua";
    attr String textoExtremoOrigen;
    attr String textoExtremoDestino;
    attr FormaExtremoOrigen formaExtremoOrigen = "Ninguna";
    attr FormaExtremoDestino formaExtremoDestino = "Ninguna";
    attr Color color= "Blanco";
}