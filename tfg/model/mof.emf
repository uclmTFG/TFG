@namespace(
	uri="mof", 
	prefix="mof")
package mof;

@gmf.diagram()
class UMLDiagram {
	val Nodo[*] nodos;
	val Enlace[*] enlaces;
}

enum Color {
	Blanco;
	Negro;
	Rojo;
	Verde;
	Amarillo;
	Azul;
	Rosa;
	Lila;
	Naranja;
}

enum Forma {
	Rectángulo;
	RectánguloRedondeado;
	Círculo;
	CírculoDoble;
	Barra;
	Rombo;
	Actor;
}

enum Linea {
	Continua;
	Discontinua;
}

enum Tipo {
	Atributo;
	Método;
}

enum Visibilidad {
	Privado;
	Público;
	Protegido;
	Paquete;
	Estático;
}

enum FormaExtremoOrigen {
	Ninguna;
	FlechaAbierta;
	FlechaCerrada;
}

enum FormaExtremoDestino{
	Ninguna;
	RomboSinRelleno;
	RomboRelleno;
}


@gmf.node(label="nombre")
class Nodo {
    attr String nombre;
    attr Forma forma ="Rectángulo";
    attr Color color = "Blanco";
    attr Color colorBorde = "Blanco";
}

@gmf.link(source="origen", target="destino", style="solid", target.decoration="arrow")
class Enlace {
    ref Nodo[1] origen;
    ref Nodo[1] destino;
}

