@namespace(
	uri="mof", 
	prefix="mof")
package mof;

@gmf.diagram()
class UMLDiagram {
	val Nodeone[*] elements;
	val Relationship[*] links;
}

enum Color {
	Blanco;
	Negro;
	Azul;
	Amarillo;
	Naranja;
	Rojo;
	Verde;
	Rosa;
	Lila;
}

abstract class Nodeone {
	attr String name;
}

@gmf.node(label="name")
class Clas extends Nodeone {
	attr Color color = "Blanco";
	attr Color colorborde = "Blanco";
}

abstract class Relationship{
	ref Nodeone[1] source;
	ref Nodeone[1] target;
}

@gmf.link(source="source", target="target", 
target.decoration="closedarrow", style="solid",
tool.name="Generatization")
class Generalization extends Relationship {}
