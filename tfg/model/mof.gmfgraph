<?xml version="1.0" encoding="ASCII"?>
<gmfgraph:Canvas xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:gmfgraph="http://www.eclipse.org/gmf/2006/GraphicalDefinition" name="mof">
  <figures name="Default">
    <figures xsi:type="gmfgraph:PolylineDecoration" name="EnlaceFigureTargetDecoration"/>
    <descriptors name="PackageFigure">
      <actualFigure xsi:type="gmfgraph:Rectangle" name="PackageFigure">
        <border xsi:type="gmfgraph:MarginBorder">
          <insets top="5" left="5" bottom="5" right="5"/>
        </border>
        <children xsi:type="gmfgraph:Label" name="PackageLabelFigure" text="Package">
          <maximumSize dx="10000" dy="50"/>
        </children>
        <children xsi:type="gmfgraph:Rectangle" name="PackageNodosCompartmentFigure" outline="false"/>
      </actualFigure>
      <accessors accessor="getFigurePackageLabelFigure" figure="//@figures.0/@descriptors.0/@actualFigure/@children.0"/>
      <accessors accessor="getPackageNodosCompartmentFigure" figure="//@figures.0/@descriptors.0/@actualFigure/@children.1"/>
    </descriptors>
    <descriptors name="NodoUnoFigure">
      <actualFigure xsi:type="gmfgraph:RoundedRectangle" name="NodoUnoFigure">
        <border xsi:type="gmfgraph:MarginBorder">
          <insets top="5" left="5" bottom="5" right="5"/>
        </border>
        <children xsi:type="gmfgraph:Label" name="NodoUnoLabelFigure" text="NodoUno"/>
      </actualFigure>
      <accessors accessor="getFigureNodoUnoLabelFigure" figure="//@figures.0/@descriptors.1/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors name="NodoDosFigure">
      <actualFigure xsi:type="gmfgraph:RoundedRectangle" name="NodoDosFigure">
        <border xsi:type="gmfgraph:MarginBorder">
          <insets top="5" left="5" bottom="5" right="5"/>
        </border>
        <children xsi:type="gmfgraph:Label" name="NodoDosLabelFigure" text="NodoDos"/>
      </actualFigure>
      <accessors accessor="getFigureNodoDosLabelFigure" figure="//@figures.0/@descriptors.2/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors name="AtributosMetodosFigure">
      <actualFigure xsi:type="gmfgraph:RoundedRectangle" name="AtributosMetodosFigure">
        <border xsi:type="gmfgraph:MarginBorder">
          <insets top="5" left="5" bottom="5" right="5"/>
        </border>
        <children xsi:type="gmfgraph:Label" name="AtributosMetodosLabelFigure" text="AtributosMetodos"/>
      </actualFigure>
      <accessors accessor="getFigureAtributosMetodosLabelFigure" figure="//@figures.0/@descriptors.3/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors name="EnlaceFigure">
      <actualFigure xsi:type="gmfgraph:PolylineConnection" name="EnlaceFigure" targetDecoration="//@figures.0/@figures.0"/>
    </descriptors>
  </figures>
  <nodes name="Package" figure="PackageFigure"/>
  <nodes name="NodoUno" figure="NodoUnoFigure"/>
  <nodes name="NodoDos" figure="NodoDosFigure"/>
  <nodes name="AtributosMetodos" figure="AtributosMetodosFigure"/>
  <connections name="Enlace" figure="EnlaceFigure"/>
  <compartments name="PackageNodosCompartment" figure="PackageFigure" collapsible="true" accessor="//@figures.0/@descriptors.0/@accessors.1"/>
  <labels name="PackageLabel" figure="PackageFigure" accessor="//@figures.0/@descriptors.0/@accessors.0"/>
  <labels name="NodoUnoLabel" figure="NodoUnoFigure" accessor="//@figures.0/@descriptors.1/@accessors.0"/>
  <labels name="NodoDosLabel" figure="NodoDosFigure" accessor="//@figures.0/@descriptors.2/@accessors.0"/>
  <labels name="AtributosMetodosLabel" figure="AtributosMetodosFigure" accessor="//@figures.0/@descriptors.3/@accessors.0"/>
</gmfgraph:Canvas>
