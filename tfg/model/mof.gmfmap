<?xml version="1.0" encoding="ASCII"?>
<gmfmap:Mapping
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:gmfmap="http://www.eclipse.org/gmf/2008/mappings"
    xmlns:gmftool="http://www.eclipse.org/gmf/2005/ToolDefinition">
  <nodes>
    <containmentFeature
        href="mof.ecore#//UMLDiagram/nodos"/>
    <ownedChild
        relatedDiagrams="//@diagram">
      <domainMetaElement
          href="mof.ecore#//Package"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping">
        <diagramLabel
            href="mof.gmfgraph#PackageLabel"/>
        <features
            href="mof.ecore#//Nodo/nombre"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="mof.gmftool#//@palette/@tools.0/@tools.3"/>
      <diagramNode
          href="mof.gmfgraph#Package"/>
      <children
          compartment="//@nodes.0/@ownedChild/@compartments.0"
          referencedChild="//@nodes.0/@ownedChild">
        <containmentFeature
            href="mof.ecore#//Package/nodos"/>
      </children>
      <children
          compartment="//@nodes.0/@ownedChild/@compartments.0"
          referencedChild="//@nodes.1/@ownedChild">
        <containmentFeature
            href="mof.ecore#//Package/nodos"/>
      </children>
      <children
          compartment="//@nodes.0/@ownedChild/@compartments.0"
          referencedChild="//@nodes.2/@ownedChild">
        <containmentFeature
            href="mof.ecore#//Package/nodos"/>
      </children>
      <children
          compartment="//@nodes.0/@ownedChild/@compartments.0"
          referencedChild="//@nodes.3/@ownedChild">
        <containmentFeature
            href="mof.ecore#//Package/nodos"/>
      </children>
      <compartments
          children="//@nodes.0/@ownedChild/@children.0 //@nodes.0/@ownedChild/@children.1 //@nodes.0/@ownedChild/@children.2 //@nodes.0/@ownedChild/@children.3">
        <compartment
            href="mof.gmfgraph#PackageNodosCompartment"/>
      </compartments>
    </ownedChild>
  </nodes>
  <nodes>
    <containmentFeature
        href="mof.ecore#//UMLDiagram/nodos"/>
    <ownedChild>
      <domainMetaElement
          href="mof.ecore#//NodoUno"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping">
        <diagramLabel
            href="mof.gmfgraph#NodoUnoLabel"/>
        <features
            href="mof.ecore#//Nodo/nombre"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="mof.gmftool#//@palette/@tools.0/@tools.2"/>
      <diagramNode
          href="mof.gmfgraph#NodoUno"/>
    </ownedChild>
  </nodes>
  <nodes>
    <containmentFeature
        href="mof.ecore#//UMLDiagram/nodos"/>
    <ownedChild>
      <domainMetaElement
          href="mof.ecore#//NodoDos"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping">
        <diagramLabel
            href="mof.gmfgraph#NodoDosLabel"/>
        <features
            href="mof.ecore#//Nodo/nombre"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="mof.gmftool#//@palette/@tools.0/@tools.1"/>
      <diagramNode
          href="mof.gmfgraph#NodoDos"/>
    </ownedChild>
  </nodes>
  <nodes>
    <containmentFeature
        href="mof.ecore#//UMLDiagram/nodos"/>
    <ownedChild>
      <domainMetaElement
          href="mof.ecore#//AtributosMetodos"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping">
        <diagramLabel
            href="mof.gmfgraph#AtributosMetodosLabel"/>
        <features
            href="mof.ecore#//Nodo/nombre"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="mof.gmftool#//@palette/@tools.0/@tools.0"/>
      <diagramNode
          href="mof.gmfgraph#AtributosMetodos"/>
    </ownedChild>
  </nodes>
  <links>
    <domainMetaElement
        href="mof.ecore#//Enlace"/>
    <labelMappings
        xsi:type="gmfmap:FeatureLabelMapping">
      <diagramLabel
          href="mof.gmfgraph#EnlaceLabel"/>
      <features
          href="mof.ecore#//Enlace/texto"/>
    </labelMappings>
    <containmentFeature
        href="mof.ecore#//UMLDiagram/enlaces"/>
    <tool
        xsi:type="gmftool:CreationTool"
        href="mof.gmftool#//@palette/@tools.1/@tools.0"/>
    <diagramLink
        href="mof.gmfgraph#Enlace"/>
    <sourceMetaFeature
        xsi:type="ecore:EReference"
        href="mof.ecore#//Enlace/origen"/>
    <linkMetaFeature
        xsi:type="ecore:EReference"
        href="mof.ecore#//Enlace/destino"/>
  </links>
  <diagram>
    <diagramCanvas
        href="mof.gmfgraph#mof"/>
    <domainModel
        href="mof.ecore#/"/>
    <domainMetaElement
        href="mof.ecore#//UMLDiagram"/>
    <palette
        href="mof.gmftool#//@palette"/>
  </diagram>
</gmfmap:Mapping>
