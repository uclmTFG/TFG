<?xml version="1.0" encoding="ASCII"?>
<gmfmap:Mapping
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:gmfmap="http://www.eclipse.org/gmf/2008/mappings"
    xmlns:gmftool="http://www.eclipse.org/gmf/2005/ToolDefinition">
  <nodes>
    <containmentFeature
        href="mof.ecore#//UMLDiagram/elements"/>
    <ownedChild>
      <domainMetaElement
          href="mof.ecore#//Clas"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping">
        <diagramLabel
            href="mof.gmfgraph#ClasLabel"/>
        <features
            href="mof.ecore#//Nodeone/name"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="mof.gmftool#//@palette/@tools.0/@tools.0"/>
      <diagramNode
          href="mof.gmfgraph#Clas"/>
    </ownedChild>
  </nodes>
  <links>
    <domainMetaElement
        href="mof.ecore#//Generalization"/>
    <containmentFeature
        href="mof.ecore#//UMLDiagram/links"/>
    <tool
        xsi:type="gmftool:CreationTool"
        href="mof.gmftool#//@palette/@tools.1/@tools.0"/>
    <diagramLink
        href="mof.gmfgraph#Generalization"/>
    <sourceMetaFeature
        xsi:type="ecore:EReference"
        href="mof.ecore#//Relationship/source"/>
    <linkMetaFeature
        xsi:type="ecore:EReference"
        href="mof.ecore#//Relationship/target"/>
  </links>
  <diagram>
    <diagramCanvas
        href="mof.gmfgraph#mof"/>
    <domainModel
        href="mof.ecore#/"/>
    <domainMetaElement
        href="mof.ecore#//UMLDiagram"/>
    <palette
        href="mof.gmftool#//@palette"/>
  </diagram>
</gmfmap:Mapping>
