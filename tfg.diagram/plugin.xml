   <extension point="org.eclipse.ui.navigator.navigatorContent" id="navigator-content">
      <?gmfgen generated="true"?>
      <navigatorContent
            id="tfg.diagram.resourceContent" 
            name="%navigatorContentName" 
            priority="normal" 
            contentProvider="mof.diagram.navigator.MofNavigatorContentProvider" 
            labelProvider="mof.diagram.navigator.MofNavigatorLabelProvider"
            icon="icons/obj16/MofDiagramFile.gif"
            activeByDefault="true">
         <triggerPoints>
            <or>
	           <and>
    	          <instanceof value="org.eclipse.core.resources.IFile"/>
        	      <test property="org.eclipse.core.resources.extension" value="mof_diagram"/>
               </and>
               <instanceof value="mof.diagram.navigator.MofAbstractNavigatorItem"/>
           	   <adapt type="org.eclipse.gmf.runtime.notation.View">
           	      <test property="tfg.diagram.isShortcut"/>
           	   </adapt>
            </or>
         </triggerPoints>
         <possibleChildren>
            <or>
         	   <instanceof value="mof.diagram.navigator.MofAbstractNavigatorItem"/>
           	   <adapt type="org.eclipse.gmf.runtime.notation.View">
           	      <test property="tfg.diagram.isShortcut"/>
           	   </adapt>
            </or>
         </possibleChildren>
         <commonSorter 
               id="tfg.diagram.navigatorSorter" 
               class="mof.diagram.navigator.MofNavigatorSorter">
            <parentExpression>
               <or>
	              <and>
    	             <instanceof value="org.eclipse.core.resources.IFile"/>
        	         <test property="org.eclipse.core.resources.extension" value="mof_diagram"/>
                  </and>
                  <instanceof value="mof.diagram.navigator.MofAbstractNavigatorItem"/>
               </or>
            </parentExpression>
         </commonSorter>
      </navigatorContent>
      <navigatorContent
            id="tfg.diagram.domainResourceContent" 
            name="%domainNavigatorContentName" 
            priority="normal" 
            contentProvider="mof.diagram.navigator.MofDomainNavigatorContentProvider" 
            labelProvider="mof.diagram.navigator.MofDomainNavigatorLabelProvider"
            icon="icons/obj16/MofDiagramFile.gif"
            activeByDefault="true">
         <triggerPoints>
            <or>
	           <and>
    	          <instanceof value="org.eclipse.core.resources.IFile"/>
        	      <test property="org.eclipse.core.resources.extension" value="mof"/>
               </and>
               <instanceof value="mof.diagram.navigator.MofDomainNavigatorItem"/>
            </or>
         </triggerPoints>
         <possibleChildren>
            <instanceof value="mof.diagram.navigator.MofDomainNavigatorItem"/>
         </possibleChildren>
      </navigatorContent>
      <actionProvider
            id="tfg.diagram.navigatorActionProvider"
            class="mof.diagram.navigator.MofNavigatorActionProvider">
         <enablement>
            <or>
               <instanceof value="mof.diagram.navigator.MofAbstractNavigatorItem"/>
           	   <adapt type="org.eclipse.gmf.runtime.notation.View">
           	      <test property="tfg.diagram.isShortcut"/>
           	   </adapt>
            </or>
         </enablement>
      </actionProvider>
   </extension>
   
