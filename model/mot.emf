@namespace(
	uri="mot", 
	prefix="mot")
package components;

@gmf.diagram()
class UMLDiagram {
	val Classifier[*] elements; 
	val Relationship[*] links;
	val Note[*] notes;
    val NoteLink[*] noteLinks;
}

enum Visibility {
	public = 0;
	private = 1;
	protected = 2;
}

abstract class Classifier {
	attr String name;
}

@gmf.node(label="name", figure="rectangle", 
border.color="0,0,0")
class Clas extends Classifier {
	attr String stereotype = "<<class>>";
	
	@gmf.compartment(layout="list", 
	collapsible="true")
	val Property[*] attributes;
	
	@gmf.compartment(layout="list", 
	collapsible="true")
	val Method[*] operations;
}

@gmf.node(label="name", figure="rectangle", 
border.color="0,0,0", color="240,240,240")
class Interface extends Classifier {
	attr String stereotype = "<<interface>>";
	
	@gmf.compartment(layout="list", 
	collapsible="true")
	val Method[*] operations;
}

@gmf.node(label="visibility,name,type", 
label.view="{0}{1} : {2}", label.edit="{1}:{2}",
figure="rectangle", tool.name="Attribute")
class Property {
	attr Visibility visibility = "public";
	attr String name = "attribute";
	attr String type = "String";
}

@gmf.node(label="visibility,name", label.view="{0}{1}()",
figure="rectangle", tool.name="Operation")
class Method {
	attr Visibility visibility = "public";
	attr String name = "operation";
}


abstract class Relationship{
	ref Classifier[1] source;
	ref Classifier[1] target;
}

@gmf.link(source="source", target="target", 
target.decoration="closedarrow", style="solid",
tool.name="Generatization")
class Generalization extends Relationship {}

@gmf.link(source="source", target="target", 
target.decoration="closedarrow", style="dash", 
tool.name="Interface Realization")
class Implementation extends Relationship{}

@gmf.link(source="source", target="target", 
label="role", style="solid",  
tool.name="Association")
class Association extends Relationship {
	attr String role = "uses";
}

@gmf.link(source="source", target="target", 
source.decoration="rhomb", style="solid",  
tool.name="Aggregation")
class Aggregation extends Relationship {}

@gmf.link(source="source", target="target", 
source.decoration="filledrhomb", style="solid",  
tool.name="Composition")
class Composition extends Relationship {}

@gmf.node(label="text", figure="polygon", 
polygon.x="0 80 100 100 0", polygon.y="0 0 20 100 100",
color="255,255,200")
class Note {
	@gmf.label
	attr String text = "Escribe tu nota aquí...";
}

@gmf.link(source="note", target="element", style="dash",
color="150,150,150", tool.name="Note Link")
class NoteLink {
	ref Note[1] note;
	ref Classifier[1] element;
}