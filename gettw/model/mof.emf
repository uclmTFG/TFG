@namespace(uri="mof", prefix="mof")
package mof;

@gmf.diagram
class UMLDiagram {
	val Nodo[*] nodos;
	val Enlace[*] enlaces;
}

enum Color {
	Blanco = 0;
	Negro = 1;
	Rojo = 2;
	Verde = 3;
	Amarillo = 4;
	Azul = 5;
	Rosa = 6;
	Lila = 7;
	Naranja = 8;
}

enum Forma {
	Rectangulo = 0;
	RectanguloRedondeado = 1;
	Circulo = 2;
	CirculoDoble = 3;
	Barra = 4;
	Rombo = 5;
	Actor = 6;
}

enum Linea {
	Continua = 0;
	Discontinua = 1;
}

enum Visibilidad {
	Privado = 0;
	Publico = 1;
	Protegido = 2;
	Paquete = 3;
	Estático = 4;
}

enum FormaExtremoOrigen {
	Ninguna = 0;
	FlechaAbierta = 1;
	FlechaCerrada = 2;
}

enum FormaExtremoDestino {
	Ninguna = 0;
	RomboSinRelleno = 1;
	RomboRelleno = 2;
}

abstract class Nodo {
	attr String nombre;
	attr Color color = "Blanco";
	attr Color colorBorde = "Blanco";
}

@gmf.node(label="nombre", figure="rectangle")
class NodoUno extends Nodo {

	@gmf.compartment(layout="list", collapsible="true")
	val NodoDos[*] nodosDos;
}

@gmf.node(label="nombre")
class NodoDos extends Nodo {
	attr Forma forma = "Rectangulo";
	attr Linea linea = "Continua";
}

@gmf.link(source="origen", target="destino", style="solid", target.decoration="arrow", label="texto")
class Enlace {
	attr String texto;
	ref Nodo[1] origen;
	ref Nodo[1] destino;
	attr Linea linea = "Continua";
	attr String textoExtremoOrigen;
	attr String textoExtremoDestino;
	attr FormaExtremoOrigen formaExtremoOrigen = "Ninguna";
	attr FormaExtremoDestino formaExtremoDestino = "Ninguna";
	attr Color color = "Blanco";
}

