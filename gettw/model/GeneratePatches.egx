// Importa el plugin que contiene operaciones de Eugenia
import "platform:/plugin/org.eclipse.epsilon.eugenia/transformations/ECoreUtil.eol";

// Define una nueva regla
rule FixExternalLabelMargins
	
	// Aplicar esta regla a todas las clases del Ecore
	transform c : ECore!EClass
{
	// Si la clase tiene la anotación @gmf.node(label.placement="external")
	guard: c.getLabelPlacement() == "external"
	
	// Invoca a FixExternalLabelMargin.egl
	// Este archivo edita el contenido por defecto de los margenes del texto y la figura, disminuyendo el número
	template: "FixExternalLabelMargin.egl"
	
	// Le pasa los parámetros para que busque la carpeta de cada clase detectada
	parameters: Map { "srcDir" = getSourceDirectory(), "node" = c.name }
	
	// Crea un archivo con cada clase
	target : "FixExternalLabelMarginsFor" + c.name + ".patch"
}

// Función que busca el directorio de cada nodo que contiene la configuración de .gmfgen
@cache
operation getSourceDirectory() {
	var genEditor = GmfGen!GenEditorGenerator.all.first;
	return genEditor.pluginDirectory.substring(1) + "/" +
			genEditor.packageNamePrefix.replace("\\.","/");
}